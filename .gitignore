# === Hora da Tarefa - .gitignore ===
# Stack: Next.js + FastAPI + Postgres + Redis + MinIO + Ollama/llama.cpp + Caddy + Telegram bot

# --- Segredos / env ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
secrets.json

# --- Python (FastAPI, aiogram, Celery, PaddleOCR) ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env_venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
htmlcov/
*.egg-info/
dist/
build/

# --- Node / Next.js (frontend) ---
node_modules/
frontend/node_modules/
.next/
out/
dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- TypeScript / build ---
*.tsbuildinfo
next-env.d.ts

# --- Docker / infra local ---
docker-compose.override.yml
data/
pgdata/
redis-data/
minio-data/
caddy-data/
caddy-config/
*.sqlite
*.sqlite3
*.db

# --- Uploads e imagens de tarefas (LGPD: nunca commitar) ---
/data/images/
uploads/
*.jpg.original
backend/uploads/
frontend/public/uploads/

# --- Modelos IA locais (pesados - baixar via script, não commitar) ---
*.gguf
*.ggml
*.bin
*.onnx
*.pt
*.safetensors
models/
ai/models/
ollama/
!ai/models/.gitkeep

# --- Logs / temporários ---
logs/
*.log
tmp/
temp/
.cache/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# --- Testes / coverage ---
.coverage
junit.xml
playwright-report/
test-results/
