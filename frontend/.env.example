# URL base da API FastAPI (sem /v1 no final).
# Com `docker compose up`: aponte para o Caddy (:80 padrão; :8081 com o override
# local desta máquina, onde 80/443 estão ocupadas). Com uvicorn direto: :8000.
NEXT_PUBLIC_API_URL=http://localhost:8081
# @username do bot no BotFather (sem @). Vazio = instruções genéricas.
NEXT_PUBLIC_TELEGRAM_BOT=
