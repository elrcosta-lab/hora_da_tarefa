# === Hora da Tarefa - .env.example (v1.1 OpenRouter) ===
# Copie para .env (nunca commite .env — ver .gitignore)
# IA 100% via OpenRouter, sem VLM local. Modelo padrão: google/gemma-4-26b-a4b-it:free

# --- OpenRouter (obrigatório p/ extração) ---
OPENROUTER_API_KEY=sk-or-v1-SUA_CHAVE_AQUI
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://horadatarefa.app
OPENROUTER_APP_NAME=Hora da Tarefa
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_TOKENS=2048
OPENROUTER_TEMPERATURE=0.1

# --- Pipeline IA ---
AI_ENABLED=true
AI_CONFIDENCE_OK=0.75
AI_CONFIDENCE_REVIEW=0.60
AI_WORKER_CONCURRENCY=3
AI_MAX_IMAGE_SIDE=1600
AI_JPEG_QUALITY=82

# --- Backend / Auth ---
POSTGRES_PASSWORD=troque-postgres-secret
DATABASE_URL=postgresql+psycopg://hora:hora@postgres:5432/hora_da_tarefa
REDIS_URL=redis://redis:6379/0
JWT_SECRET=troque-por-segredo-forte-32-chars-min
JWT_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=7
X_BOT_TOKEN=troque-por-token-interno-bot-api

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-sua-chave-botfather
TELEGRAM_WEBHOOK_SECRET=troque-por-segredo-webhook
TELEGRAM_LIVE_SEND=false
RUN_MODE=polling

# --- Storage (MinIO S3-compatível em prod via compose; local em dev/testes) ---
STORAGE_BACKEND=local
S3_ENDPOINT=http://minio:9000
S3_BUCKET=hora-tarefa-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=troque-minio-secret
RETENTION_IMAGE_DAYS=90

# --- App ---
TIMEZONE_DEFAULT=America/Sao_Paulo
LOCALE_DEFAULT=pt-BR
ENV=dev

# --- Web (compose) ---
WEB_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
